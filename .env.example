# Web -------------------------------------------------------------------
# Host name the app is reached under (used for nginx server_name + the app URL that SSO callbacks/absolute links are built from).
# MUST include the port when it is not 80, e.g. localhost:8080 — keep it in sync with HTTP_PORT below.
# For production (ENABLE_TLS=true) this must be a real, publicly-resolvable bare hostname (no port),
# e.g. pathfinder.example.com — Let's Encrypt's HTTP-01 challenge must reach port 80 here from the internet.
DOMAIN=localhost:8080
# Host port mapped to the container's nginx (http://localhost:8080).
# For production (ENABLE_TLS=true) this MUST be 80: Let's Encrypt's HTTP-01 challenge always
# connects to port 80 on DOMAIN, regardless of this variable's name/value.
HTTP_PORT=8080
# Basic-auth password protecting the /setup route (user: pf).
APP_PASSWORD=CHANGE_ME

# TLS (production only) ---------------------------------------------------
# Set to true to serve HTTPS via nginx's native ACME module (Let's Encrypt).
# See docs/deployment.md "Production / TLS" - also requires HTTP_PORT=80 above.
ENABLE_TLS=false
# Host port mapped to the container's nginx HTTPS listener, only used when ENABLE_TLS=true.
HTTPS_PORT=443
# Let's Encrypt account contact email. Required when ENABLE_TLS=true.
ACME_EMAIL=
# Swap to https://acme-staging-v02.api.letsencrypt.org/directory while testing, to avoid production rate limits.
ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# Timezone --------------------------------------------------------------
TZ=UTC

# Database --------------------------------------------------------------
MYSQL_HOST=pfdb
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=CHANGE_ME
MYSQL_USER=pathfinder
MYSQL_PASSWORD=CHANGE_ME
MYSQL_PF_DB_NAME=pathfinder
MYSQL_UNIVERSE_DB_NAME=eve_universe

# Redis -----------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# Websocket -------------------------------------------------------------
PATHFINDER_SOCKET_HOST=socket
PATHFINDER_SOCKET_PORT=5555

# EVE Online SSO / ESI --------------------------------------------------
CCP_SSO_CLIENT_ID=
CCP_SSO_SECRET_KEY=
CCP_ESI_SCOPES=esi-location.read_location.v1,esi-location.read_ship_type.v1,esi-search.search_structures.v1,esi-clones.read_clones.v1,esi-universe.read_structures.v1,esi-corporations.read_corporation_membership.v1,esi-ui.open_window.v1,esi-ui.write_waypoint.v1,esi-characters.read_corporation_roles.v1,esi-location.read_online.v1
